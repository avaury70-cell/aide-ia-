# ---------------------------------------------------------------------------
# Configuration d'Aide. Copiez ce fichier en « .env » puis complétez-le.
# ---------------------------------------------------------------------------

# 1) Clé API Anthropic (obligatoire pour discuter avec l'assistant)
#    À créer sur https://console.anthropic.com → « API Keys »
ANTHROPIC_API_KEY=

# 2) Maison simulée : true pour essayer sans Home Assistant ni objet connecté.
#    Passez à false quand vous branchez votre vraie maison.
DEMO_MODE=true

# 3) Home Assistant (uniquement si DEMO_MODE=false)
#    URL de votre Home Assistant et jeton d'accès longue durée (Profil → Sécurité)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Réglages avancés (facultatifs)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
HOME_TIMEZONE=Europe/Paris
# WHISPER_MODEL=base    # modèle vocal plus léger pour les petites machines

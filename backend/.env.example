# Base de données (PostgreSQL en production)
DATABASE_URL=postgresql+asyncpg://aide:aide@db:5432/aide
# Secret de signature des jetons JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=change-me
# Clé API Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Home Assistant : URL et jeton d'accès longue durée (Profil > Sécurité)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Fuseau horaire du domicile (automatisations planifiées)
HOME_TIMEZONE=Europe/Paris

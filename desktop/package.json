{
  "name": "aide-desktop",
  "productName": "Aide",
  "version": "1.0.0",
  "description": "Assistant domestique intelligent — application de bureau",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env AIDE_DEV_URL=http://localhost:5173 electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview:web": "vite build && vite preview --port 4173"
  },
  "build": {
    "appId": "fr.aide.desktop",
    "productName": "Aide",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.lifestyle",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Aide utilise le micro pour comprendre vos commandes vocales."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  }
}
